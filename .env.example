# Copy this file to .env and edit as needed.
# Default is mock mode: deterministic logic only, no API key required.
MOCK_MODE=true

# Only needed when MOCK_MODE=false, to let src/llm.py call Claude to polish
# the review packet's narrative paragraph (it never changes the risk tier,
# controls, or RACI — those are always computed by src/engine.py).
ANTHROPIC_API_KEY=
